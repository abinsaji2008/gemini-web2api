{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/v1/models",
      "destination": "/api/models.py"
    },
    {
      "source": "/v1/chat/completions",
      "destination": "/api/chat_completions.py"
    },
    {
      "source": "/v1/responses",
      "destination": "/api/responses.py"
    }
  ]
}
