{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py/"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index.py/v1/:path*"
    },
    {
      "source": "/v1beta/:path*",
      "destination": "/api/index.py/v1beta/:path*"
    }
  ]
}
